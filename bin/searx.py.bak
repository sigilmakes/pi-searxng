#!/usr/bin/env python3
"""searx — CLI for SearXNG search, fetch, and service management.

Composable search primitives for the agent harness.
Returns JSON by default for piping. Use --text for human-readable output.

Examples:
  searx search "rust async" -c it -n 3
  searx search "query" --json | jq '.results[0].url'
  searx fetch "https://example.com" -n 3000
  searx status
  searx restart
"""

import argparse
import json
import os
import subprocess
import sys
import urllib.parse
import urllib.request
import html as html_mod
import re
from pathlib import Path

SEARXNG_URL = os.environ.get("SEARXNG_URL", "http://localhost:8042")
COMPOSE_FILE = str(
    Path(__file__).resolve().parent.parent / "docker" / "docker-compose.yaml"
)

# ── HTTP helpers ──────────────────────────────────────────


def _fetch_json(url, timeout=15):
    """GET url, return parsed JSON or exit with error."""
    req = urllib.request.Request(url, headers={"User-Agent": "searx-cli/1.0", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        print(f"Error: HTTP {e.code} from SearXNG", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Error: cannot reach SearXNG at {SEARXNG_URL} — {e.reason}", file=sys.stderr)
        print("Try: searx start", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


def _health_check():
    """Return True if SearXNG is responding."""
    try:
        req = urllib.request.Request(SEARXNG_URL, headers={"User-Agent": "searx-cli/1.0"})
        with urllib.request.urlopen(req, timeout=3):
            return True
    except Exception:
        return False


# ── Docker compose helpers ────────────────────────────────


def _docker_compose(*args):
    """Run docker compose with the repo's compose file."""
    cmd = ["docker", "compose", "-f", COMPOSE_FILE] + list(args)
    result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    return result


# ── Search ──────────────────────────────────────────────────


def cmd_search(args):
    params = {
        "q": args.query,
        "format": "json",
        "pageno": str(args.page),
    }
    if args.categories:
        params["categories"] = args.categories
    if args.engines:
        params["engines"] = args.engines
    if args.time_range:
        params["time_range"] = args.time_range
    if args.language:
        params["language"] = args.language

    url = f"{SEARXNG_URL}/search?{urllib.parse.urlencode(params)}"
    data = _fetch_json(url)

    limit = args.limit or 8
    results = data.get("results", [])[:limit]

    # --json: raw SearXNG response (full or results only)
    if args.json:
        if args.limit:
            data["results"] = results
        print(json.dumps(data, indent=2))
        return

    # Structured JSON output (default)
    output = {
        "query": data.get("query", args.query),
        "total": data.get("number_of_results", 0),
        "returned": len(results),
        "page": args.page,
        "results": [
            {
                "title": r.get("title", ""),
                "url": r.get("url", ""),
                "snippet": (r.get("content") or "")[:300],
                "engines": r.get("engines", []),
                "date": r.get("publishedDate"),
                "category": r.get("category", "general"),
                "score": r.get("score"),
            }
            for r in results
        ],
    }

    if data.get("answers"):
        output["answers"] = data["answers"]
    if data.get("suggestions"):
        output["suggestions"] = data["suggestions"]
    if data.get("unresponsive_engines"):
        output["unresponsive"] = [
            {"engine": e[0], "reason": e[1]} for e in data["unresponsive_engines"]
        ]

    if args.text:
        _print_text_results(output)
    else:
        print(json.dumps(output, indent=2))


def _print_text_results(data):
    """Human-readable output."""
    print(f"Search: \"{data['query']}\" — {data['returned']} results")

    unresponsive = data.get("unresponsive", [])
    if unresponsive and len(data["results"]) == 0:
        print(f"\n⚠ All engines unresponsive: {', '.join(e['engine'] for e in unresponsive)}")
        print("Try: searx restart")
        return

    if unresponsive:
        down = ", ".join(f"{e['engine']} ({e['reason']})" for e in unresponsive)
        print(f"⚠ {len(unresponsive)} engine(s) down: {down}")

    for i, r in enumerate(data["results"], 1):
        print(f"\n{i}. {r['title']}")
        print(f"   {r['url']}")
        if r.get("snippet"):
            print(f"   {r['snippet']}")
        meta = []
        if len(r.get("engines", [])) > 1:
            meta.append(", ".join(r["engines"]))
        if r.get("date"):
            meta.append(r["date"][:10])
        if meta:
            print(f"   {' · '.join(meta)}")

    if data.get("answers"):
        print(f"\nDirect answers:")
        for a in data["answers"]:
            print(f"  • {a}")

    if data.get("suggestions"):
        print(f"\nRelated: {', '.join(data['suggestions'])}")


# ── Fetch ──────────────────────────────────────────────────


def cmd_fetch(args):
    url = args.url
    max_chars = args.max_chars or 5000
    offset = args.offset or 0

    try:
        result = subprocess.run(
            ["uvx", "--from", "markitdown[pdf]", "markitdown", url],
            capture_output=True,
            text=True,
            timeout=45,
    
        )
    except FileNotFoundError:
        print("Error: uvx not found. Install with: curl -LsSf https://astral.sh/uv/install.sh | sh", file=sys.stderr)
        sys.exit(1)
    except subprocess.TimeoutExpired:
        print("Error: markitdown timed out (45s)", file=sys.stderr)
        sys.exit(1)

    if result.returncode != 0:
        stderr = result.stderr.strip()
        print(f"Error: markitdown failed — {stderr[:200] if stderr else 'unknown error'}", file=sys.stderr)
        sys.exit(1)

    text = result.stdout.strip()
    if not text:
        print("Error: markitdown returned empty output", file=sys.stderr)
        sys.exit(1)

    total = len(text)
    sliced = text[offset : offset + max_chars]
    remaining = total - (offset + len(sliced))

    output = {
        "url": url,
        "total_length": total,
        "offset": offset,
        "shown_length": len(sliced),
        "has_more": remaining > 0,
        "content": sliced,
    }

    if remaining > 0:
        output["next_offset"] = offset + max_chars

    if args.text:
        print(sliced)
        if remaining > 0:
            print(f"\n--- [{remaining} more characters, use --offset {offset + max_chars}] ---")
    else:
        print(json.dumps(output, indent=2))


# ── Status ──────────────────────────────────────────────────


def cmd_status(args):
    healthy = _health_check()
    container_result = _docker_compose("ps", "--format", "json")

    output = {
        "url": SEARXNG_URL,
        "healthy": healthy,
        "compose_file": COMPOSE_FILE,
    }

    # Parse container status
    containers = []
    if container_result.returncode == 0 and container_result.stdout.strip():
        try:
            for line in container_result.stdout.strip().split("\n"):
                if line.strip():
                    containers.append(json.loads(line))
        except json.JSONDecodeError:
            containers = [{"raw": container_result.stdout.strip()}]
    output["containers"] = containers

    if healthy:
        # Quick engine health check
        try:
            data = _fetch_json(f"{SEARXNG_URL}/search?q=test&format=json&categories=general&limit=1", timeout=5)
            results_count = len(data.get("results", []))
            unresponsive = data.get("unresponsive_engines", [])
            output["engine_check"] = {
                "results": results_count,
                "unresponsive_count": len(unresponsive),
                "unresponsive": [{"engine": e[0], "reason": e[1]} for e in unresponsive],
            }
        except Exception:
            output["engine_check"] = {"error": "could not query engines"}

    if args.text:
        status = "✓ running" if healthy else "✗ not responding"
        print(f"SearXNG: {status}")
        print(f"URL: {SEARXNG_URL}")
        print(f"Compose: {COMPOSE_FILE}")
        if healthy and "engine_check" in output:
            ec = output["engine_check"]
            print(f"Health check: {ec.get('results', '?')} result(s)")
            if ec.get("unresponsive"):
                down = ", ".join(f"{e['engine']} ({e['reason']})" for e in ec["unresponsive"])
                print(f"Unresponsive: {down}")
            else:
                print("All queried engines responding.")
    else:
        print(json.dumps(output, indent=2))


# ── Service lifecycle ──────────────────────────────────────


def cmd_start(args):
    if _health_check():
        if args.text:
            print("SearXNG already running.")
        else:
            print(json.dumps({"status": "already_running", "url": SEARXNG_URL}))
        return

    result = _docker_compose("up", "-d")
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip()}", file=sys.stderr)
        sys.exit(1)

    # Wait for healthy
    import time
    for i in range(20):
        time.sleep(1)
        if _health_check():
            if args.text:
                print("SearXNG started successfully.")
            else:
                print(json.dumps({"status": "started", "url": SEARXNG_URL}))
            return

    print("Error: SearXNG did not become healthy within 20 seconds", file=sys.stderr)
    sys.exit(1)


def cmd_stop(args):
    result = _docker_compose("down")
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    if args.text:
        print("SearXNG stopped.")
    else:
        print(json.dumps({"status": "stopped"}))


def cmd_restart(args):
    # Stop
    _docker_compose("restart")

    import time
    for i in range(20):
        time.sleep(1)
        if _health_check():
            if args.text:
                print("SearXNG restarted.")
            else:
                print(json.dumps({"status": "restarted", "url": SEARXNG_URL}))
            return

    if args.text:
        print("Warning: SearXNG restarted but not yet responding. May need a moment.")
    else:
        print(json.dumps({"status": "restarting", "url": SEARXNG_URL}))


def cmd_engines(args):
    data = _fetch_json(f"{SEARXNG_URL}/config", timeout=5)

    enabled = [e for e in data.get("engines", []) if e.get("enabled")]
    disabled = [e for e in data.get("engines", []) if not e.get("enabled")]
    categories = data.get("categories", [])

    # Group enabled engines by category
    by_category = {}
    for e in enabled:
        for cat in e.get("categories", ["other"]):
            by_category.setdefault(cat, []).append(e["name"])

    output = {
        "total_enabled": len(enabled),
        "total_disabled": len(disabled),
        "categories": categories,
        "engines_by_category": by_category,
    }

    if args.text:
        print(f"Engines: {len(enabled)} enabled, {len(disabled)} disabled")
        print(f"Categories: {', '.join(categories)}\n")
        for cat in sorted(by_category):
            print(f"  {cat}: {', '.join(sorted(by_category[cat]))}")
    else:
        print(json.dumps(output, indent=2))


# ── Main ───────────────────────────────────────────────────


def main():
    parser = argparse.ArgumentParser(
        prog="searx",
        description="SearXNG CLI — composable search primitives",
    )
    parser.add_argument("--text", action="store_true", help="Human-readable output (default: JSON)")
    sub = parser.add_subparsers(dest="command")

    # search
    s = sub.add_parser("search", help="Search the web")
    s.add_argument("query", nargs="+", help="Search query")
    s.add_argument("-c", "--categories", help="Categories: general,news,it,science,etc (comma-separated)")
    s.add_argument("-e", "--engines", help="Engines: google,brave,wikipedia,etc (comma-separated)")
    s.add_argument("-t", "--time-range", help="Time range: day,week,month,year")
    s.add_argument("-l", "--language", help="Language code: en,de,fr,etc")
    s.add_argument("-n", "--limit", type=int, default=8, help="Max results (default: 8)")
    s.add_argument("-p", "--page", type=int, default=1, help="Page number")
    s.add_argument("--json", action="store_true", help="Raw SearXNG JSON output (for jq piping)")

    # fetch
    f = sub.add_parser("fetch", help="Fetch URL and convert to markdown")
    f.add_argument("url", help="URL to fetch")
    f.add_argument("-n", "--max-chars", type=int, default=5000, help="Max characters (default: 5000)")
    f.add_argument("-o", "--offset", type=int, default=0, help="Character offset for pagination")

    # status
    sub.add_parser("status", help="Show service health")

    # start
    sub.add_parser("start", help="Start SearXNG")

    # stop
    sub.add_parser("stop", help="Stop SearXNG")

    # restart
    sub.add_parser("restart", help="Restart SearXNG (clears engine suspensions)")

    # engines
    sub.add_parser("engines", help="List enabled engines by category")

    args = parser.parse_args()

    if not args.command:
        # Default: show status
        args.command = "status"
        args.text = True
        cmd_status(args)
        return

    # Merge query words
    if args.command == "search":
        args.query = " ".join(args.query)

    dispatch = {
        "search": cmd_search,
        "fetch": cmd_fetch,
        "status": cmd_status,
        "start": cmd_start,
        "stop": cmd_stop,
        "restart": cmd_restart,
        "engines": cmd_engines,
    }

    handler = dispatch.get(args.command)
    if handler:
        handler(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()